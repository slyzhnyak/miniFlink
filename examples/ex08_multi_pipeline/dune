; Пример 8: множество пайплайнов на реальном Kafka.
;
; Три части:
;  - pipelines.ml   — чистые Stream-графы (без I/O), собираются ВСЕГДА;
;  - test_ex08_graphs — тест графов на моkáх (без Kafka), собирается ВСЕГДА;
;  - ex08_multi_pipeline — Kafka-обёртка + оркестрация доменов, собирается
;    ТОЛЬКО в профиле 'rdkafka' (нужна системная librdkafka).
;
; Запуск примера (нужен брокер на localhost:9092):
;   dune exec --profile rdkafka \
;     examples/ex08_multi_pipeline/ex08_multi_pipeline.exe

; Чистые графы — отдельная библиотека, доступна и примеру, и тесту.
(library
 (name pipelines)
 (libraries miniflink)
 (flags (:standard -w +a-4-26-27-32-33-37-39-40-41-42-44-45-70))
 (modules pipelines))

; Тест графов на моках — без Kafka, собирается всегда.
(test
 (name test_ex08_graphs)
 (libraries miniflink pipelines)
 (flags (:standard -w +a-4-26-27-32-33-37-39-40-41-42-44-45-70))
 (modules test_ex08_graphs))

; Kafka-обёртка + оркестрация — только в профиле rdkafka.
(executable
 (name ex08_multi_pipeline)
 (libraries miniflink kafka_connector kafka_rdkafka pipelines unix threads.posix)
 ; Domain.spawn требует OCaml >= 5; плюс профиль rdkafka (librdkafka).
 (enabled_if (and (= %{profile} rdkafka) (>= %{ocaml_version} 5)))
 (flags (:standard -w +a-4-26-27-32-33-37-39-40-41-42-44-45-70))
 (modules ex08_multi_pipeline))
