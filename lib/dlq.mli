(** Dead Letter Queue — карантин для необработанных сообщений.

    Невалидные или не прошедшие decode сообщения не роняют конвейер:
    они отправляются в DLQ вместе с контекстом ошибки (топик, payload,
    текст ошибки, timestamp, номер попытки), а обработка продолжается.

    Реализации:
    - {!Dlq_noop} — молча считает (нулевой overhead, для тестов);
    - {!Dlq_log} — пишет в stderr с полным контекстом. *)

(** Непрозрачный handle очереди. *)
type t

(** Запись об отброшенном сообщении. *)
type entry = {
  topic   : string;  (** топик/источник сообщения *)
  payload : bytes;   (** сырой payload, не прошедший обработку *)
  error   : string;  (** текст ошибки decode/обработки *)
  ts      : int;     (** Unix timestamp в миллисекундах *)
  attempt : int;     (** номер попытки обработки *)
}

(** Создать новую очередь. *)
val create : unit -> t

(** Отправить запись в DLQ. *)
val send : t -> entry -> unit

(** Сбросить буфер (для реализаций с буферизацией). *)
val flush : t -> unit

(** Сколько сообщений всего отправлено в DLQ. *)
val count : t -> int
