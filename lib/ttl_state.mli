(** Общий keyed-state с TTL — записи истекают через [ttl] (по event-time)
    после последнего обновления. Обобщение TTL Table'а на произвольное
    состояние оператора; ограничивает память при растущем пространстве
    ключей.

    Истечение по EVENT-TIME (передаётся [now]), детерминированно и
    согласуется с watermark-моделью. Идиома: [put ~now:ts] на событии,
    [advance ~now:wm] на watermark. *)

type ('k, 'v) t

(** [create ~ttl ()] — пустое хранилище; запись живёт [ttl] от
    последнего обновления. *)
val create : ttl:Time.t -> unit -> ('k, 'v) t

(** Записать/обновить значение, освежив TTL (отсчёт с [now]). *)
val put : ('k, 'v) t -> now:Time.t -> 'k -> 'v -> unit

(** Значение, если оно ещё живо на момент [now]; иначе [None].
    Истёкшее не «воскрешается» (читается как [None] даже до [advance]). *)
val get : ('k, 'v) t -> now:Time.t -> 'k -> 'v option

(** Физически удалить записи, истёкшие на момент [now] (вызывать на
    watermark для ограничения памяти). *)
val advance : ('k, 'v) t -> now:Time.t -> unit

(** Число физически хранимых записей (включая не вычищенные истёкшие —
    вызови [advance] перед [size] для точного живого числа). *)
val size : ('k, 'v) t -> int

(** Явно удалить ключ. *)
val remove : ('k, 'v) t -> 'k -> unit

(** Живые пары на момент [now]. *)
val to_list : ('k, 'v) t -> now:Time.t -> ('k * 'v) list
