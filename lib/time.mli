(** Единицы времени. Внутреннее представление — миллисекунды ([int]),
    все события и watermarks используют эту шкалу. Конструкторы ниже
    делают код читаемым: [seconds 30] вместо [30_000]. *)

(** Время в миллисекундах. *)
type t = int

(** Миллисекунды как есть. *)
val ms : int -> t

(** Секунды → миллисекунды. *)
val seconds : int -> t

(** Минуты → миллисекунды. *)
val minutes : int -> t

(** Часы → миллисекунды. *)
val hours : int -> t
