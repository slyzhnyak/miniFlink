(* ============================================================
   Ctx_store — хранилище ambient-контекста Runtime_context.

   Две реализации по версии OCaml (как channel/parallel), потому что
   корректное хранилище зависит от модели многопоточности:
   - v4 (Thread + GIL): один поток исполнения, простой [ref] безопасен.
   - v5 (Domain): домены исполняются параллельно; глобальный [ref] был
     бы общим на все домены (data race). Хранилище domain-local через
     [Domain.DLS] — у каждого домена свой контекст.

   ТИПОБЕЗОПАСНОСТЬ (A-2): модуль — функтор по типу ячейки [T.t], а не
   [Obj.t]. Runtime_context инстанцирует [Make] своим типом контекста,
   поэтому приведения через [Obj] не нужны. Цикл зависимостей не
   возникает: функтор параметризуется анонимной структурой с [type t],
   а сам Ctx_store на Runtime_context не ссылается.

   [get] возвращает [None], если в этом потоке/домене ещё не вызывали
   [set] — тогда Runtime_context подставляет дефолт.

   ВАЖНО про v5: domain-local контекст НЕ наследуется при
   [Domain.spawn] — новый домен стартует с [None] (→ дефолт). Это
   корректно: параллельные воркеры не читают Runtime_context (их
   персистентность идёт через barrier-checkpoint). *)

module type CELL = sig type t end

module Make (T : CELL) : sig
  (* Текущее значение ячейки для этого потока/домена, или [None]. *)
  val get : unit -> T.t option
  (* Установить значение ячейки для этого потока/домена. *)
  val set : T.t option -> unit
end
