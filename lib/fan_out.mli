(** Fan-out: один источник → N независимых выходов, у каждого своя
    стратегия backpressure (выбирается при создании). *)

(** Что делать когда буфер выхода переполнен. *)
type backpressure =
  | Block          (** не терять: источник не продвигается, пока буфер не
                       освободят. Fan-out идёт со скоростью самого
                       медленного Block-выхода. *)
  | Drop_oldest    (** выкинуть самое старое, принять новое (свежесть
                       важнее полноты — дашборды). *)
  | Drop_newest    (** выкинуть новое событие (оставить накопленное). *)

(** Описание одного выхода. *)
type 'a outlet = {
  name        : string;
  buffer_cap  : int;            (** размер буфера этого выхода *)
  on_pressure : backpressure;   (** стратегия именно для него *)
}

(** [fan_out source outlets] — раздаёт каждое событие источника во все
    выходы, по их индивидуальной политике. Возвращает по одному
    {!Stream.t} на выход (в том же порядке).

    {b Важно про Block.} В однопоточном использовании Block-выходы надо
    читать {e вперемешку}: нельзя осушить один Block-выход, не читая
    другой — backpressure застопорит источник (это семантика Block, как
    credit-based flow control во Flink). При конкурентном чтении (каждый
    выход в своём домене через supervisor) буферы разбираются
    параллельно и проблемы нет. Drop-выходы никогда не блокируют. *)
val fan_out :
  'a Mf_event.t Stream.t -> 'a outlet list -> 'a Mf_event.t Stream.t list
