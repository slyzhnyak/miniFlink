(** Pull-based ленивый поток.

    Поток — это функция [unit -> 'a option]: каждый вызов возвращает
    следующий элемент, [None] означает конец. Стек вызовов операторов
    {e и есть} граф обработки — никаких колбэков и промежуточных
    буферов (кроме {!flat_map}, где буфер необходим). *)

(** Тип потока элементов ['a]. Поток ленивый и одноразовый: элементы
    вычисляются по требованию, повторный проход требует нового потока. *)
type 'a t = unit -> 'a option

(** Поток из списка (в исходном порядке). *)
val of_list : 'a list -> 'a t

(** Пустой поток (сразу [None]). *)
val empty : 'a t

(** [map f s] применяет [f] к каждому элементу лениво. *)
val map : ('a -> 'b) -> 'a t -> 'b t

(** [filter p s] пропускает только элементы, удовлетворяющие [p]. *)
val filter : ('a -> bool) -> 'a t -> 'a t

(** [flat_map f s] заменяет каждый элемент списком [f x], уплощая
    результат. Единственный оператор с внутренним буфером. *)
val flat_map : ('a -> 'b list) -> 'a t -> 'b t

(** [iter f s] вызывает [f] на каждом элементе ради эффекта,
    проходя поток до конца. *)
val iter : ('a -> unit) -> 'a t -> unit

(** [fold f z s] сворачивает поток слева: [f (... (f z x1) ...) xn]. *)
val fold : ('a -> 'b -> 'a) -> 'a -> 'b t -> 'a

(** Собрать поток в список (в исходном порядке). Проходит поток до конца.
    {b ⚠ Бесконечный поток:} зациклится навсегда — применяйте только к
    конечным потокам. *)
val to_list : 'a t -> 'a list

(** [tee s] — раздвоить поток на две независимые копии.

    Каждая из возвращённых копий видит {b те же} события в том же
    порядке. Копии продвигаются независимо: одна может прочитать
    несколько событий вперёд, пока другая стоит на месте.

    Реализация — synchronizing tee с буферами per-копия. Когда копия
    просит следующий элемент:
    - если её буфер не пуст — возвращает из буфера;
    - иначе вытягивает элемент из исходного потока, кладёт его в
      буфер {b другой} копии (своя получает напрямую).

    Если один потребитель сильно опережает другой, буфер для
    отстающего растёт неограниченно. В практике пайплайнов оба
    consumer'а читают синхронно — буфер остаётся размером 0-1.

    {b Важно:} не вызывайте исходный [s] после [tee] — это смешает
    события между копиями и исходным. После [tee] работайте только
    с возвращёнными копиями. *)
val tee : 'a t -> 'a t * 'a t

(** [split n s] — разделить поток на [n] независимых копий.

    Обобщение [tee] на произвольное число потребителей. Каждая копия
    видит все события исходного. Семантика та же, что у [tee]:
    synchronizing, per-копия буфер.

    [split 1 s] возвращает [[s']] — один stream эквивалентный s.
    [split 0 s] вызывает [invalid_arg]. *)
val split : int -> 'a t -> 'a t list
