(** Таблица как функция ключ → значение [option] — для [enrich]
    (обогащение потока справочными данными, left join).

    Три конструктора: статический список, живой hashtbl, и snapshot
    из потока (последнее значение по ключу). *)

(** Таблица: поиск значения ['v] по ключу ['k]. *)
type ('k, 'v) t = 'k -> 'v option

(** Статическая таблица из списка пар. Загружается один раз; для
    справочников, не меняющихся во время работы. *)
val of_list : ('k * 'v) list -> ('k, 'v) t

(** Таблица поверх изменяемого [Hashtbl] — отражает текущее содержимое
    при каждом поиске. *)
val of_hashtbl : ('k, 'v) Hashtbl.t -> ('k, 'v) t

(** Живой snapshot из потока: последнее [Data]-значение по ключу.

    Размер ограничен числом {e уникальных} ключей (replace, не add).
    Утечка возможна только при неограниченно растущем пространстве
    ключей — для такого случая см. {!of_stream_ttl}.

    Замечание: при поиске источник вычитывается до [None]. Для живого
    канала [None] = «пока пусто» (ок); для конечного [Stream.of_list]
    первый поиск осушит источник — для статики берите {!of_list}. *)
val of_stream :
  key:('a -> 'k) -> 'a Mf_event.t Stream.t -> ('k, 'a) t

(** Как {!of_stream}, но записи старше [ttl] (относительно последнего
    виденного event-time) удаляются — ограничивает размер при растущем
    пространстве ключей. *)
val of_stream_ttl :
  key:('a -> 'k) -> ttl:int -> 'a Mf_event.t Stream.t -> ('k, 'a) t
