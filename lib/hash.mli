(* Общие хеш-функции для шардирования по ключу.

   Раньше [hash_key] (djb2) дублировался в трёх местах
   (checkpoint_parallel, parallel_v4, parallel_v5). Вынесено сюда,
   чтобы алгоритм был один: при его смене шардирование во всех путях
   (обычный parallel и exactly-once) остаётся согласованным. *)

(* djb2: детерминированный строковый хеш → номер шарда [0, n).
   [n] — число шардов (> 0); при n <= 0 бросает [Invalid_argument]. *)
val key : string -> int -> int
