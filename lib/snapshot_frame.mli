(** Самоописывающая рамка вокруг снапшот-байтов, защищающая
    [Marshal.from_bytes] от сырого недоверенного/повреждённого входа
    (аудит 2026-07, N-9).

    Формат: [MAGIC(4) | version(1) | payload_len(4, BE) | md5(16) | payload].
    [unwrap]/[marshal_unwrap] проверяют магию, длину и контрольную сумму
    ДО декодирования, поэтому битый/чужой/обрезанный вход даёт [Failure],
    а не segfault (что случается с сырым Marshal на type-confused входе).

    Защищает от {b случайной} порчи (битый диск, обрезка, чужой формат),
    не от {b намеренной} атаки — злоумышленник пересчитает md5. Полная
    защита требует типобезопасного сериализатора вместо Marshal. *)

(** Обернуть сырые байты в рамку. *)
val wrap : bytes -> bytes

(** Проверить рамку, вернуть payload.
    @raise Failure если магия/версия/длина/контрольная сумма не сошлись. *)
val unwrap : bytes -> bytes

(** [wrap (Marshal.to_bytes v [])]. *)
val marshal_wrap : 'a -> bytes

(** [unwrap] + [Marshal.from_bytes]. Marshal вызывается только на данных,
    прошедших проверку рамки — случайный мусор до него не доходит.
    @raise Failure если рамка не прошла проверку. *)
val marshal_unwrap : bytes -> 'a
