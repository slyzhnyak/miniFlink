(** Комбинируемые агрегаторы для оконной агрегации.

    Агрегатор — это инкрементальная свёртка с тремя частями: начальный
    аккумулятор, шаг (свернуть событие), и финализация (аккумулятор →
    результат). Например {!mean} копит [(сумма, счёт)] и в конце делит.

    Зачем: вместо ручного [aggregate (fun _ rs -> List.fold_left ...)]
    в каждом окне — готовый комбинируемый агрегат. Ложится на
    {!Pipe.window_fold} (инкрементально, O(1) памяти на окно), а через
    {!both} / {!( and+ )} несколько агрегатов считаются за один проход.

    {[
      (* среднее и максимум температуры за одно окно *)
      let stats = Agg.(both (mean temp) (max_by temp))
      ... |> Pipe.window_agg (module Sensor) (Pipe.tumbling (seconds 10)) stats
    ]} *)

(** Агрегатор: вход ['a], скрытый аккумулятор, результат ['r].
    Параметр аккумулятора экзистенциален — наружу видны только вход и
    результат. *)
type ('a, 'r) t

(** {2 Готовые агрегаторы} *)

(** Число событий. *)
val count : ('a, int) t

(** Сумма проекции [f]. *)
val sum : ('a -> float) -> ('a, float) t

(** Среднее проекции [f] (копит сумму и счёт, делит в конце).
    Результат [None] для пустого окна. *)
val mean : ('a -> float) -> ('a, float option) t

(** Минимум проекции [f]. [None] для пустого окна. *)
val min_by : ('a -> float) -> ('a, float option) t

(** Максимум проекции [f]. [None] для пустого окна. *)
val max_by : ('a -> float) -> ('a, float option) t

(** Событие с минимальным значением проекции [f] (сам элемент, не число).
    [None] для пустого окна. *)
val arg_min : ('a -> float) -> ('a, 'a option) t

(** Событие с максимальным значением проекции [f]. [None] для пустого. *)
val arg_max : ('a -> float) -> ('a, 'a option) t

(** Первое событие окна. [None] для пустого. *)
val first : ('a, 'a option) t

(** Последнее событие окна. [None] для пустого. *)
val last : ('a, 'a option) t

(** Сколько событий удовлетворяют предикату. *)
val count_if : ('a -> bool) -> ('a, int) t

(** Собрать все события окна в список (в порядке поступления).
    Эквивалент материализующего [window]; используйте когда нужен весь
    список, иначе предпочитайте инкрементальные агрегаты выше. *)
val median : ('a -> float) -> ('a, float option) t
(** Медиана значений (чётное n — среднее двух средних). Аккумулятор —
    список: median не считается инкрементально, O(n) памяти на окно.
    При закрытии окна [finish] сортирует список — O(n log n) времени на
    каждое закрытие. Для больших окон, где это критично, рассмотрите
    {!approx_median} (P²-estimator, O(1) памяти и времени на событие). *)

val approx_median : ('a -> float) -> ('a, float option) t
(** Приближённая медиана через p² estimator (Jain-Chlamtac 1985).

    O(1) состояния независимо от размера окна (10 чисел + счётчик),
    в отличие от {!median} который держит весь список и сортирует на
    finish. Точность: обычно <1% ошибки на однородных распределениях
    после ~100 наблюдений; 5-10% на сильно асимметричных или
    тяжёлохвостых; до 25% на bimodal. Строгой математической гарантии
    как у Greenwald-Khanna нет.

    {b Когда использовать:}
    - окна {b очень} большие (>>1000 элементов на закрытие);
    - точность ±5% медианы допустима (мониторинг шумных сенсоров,
      observability метрик RSSI/latency).

    {b Когда НЕ использовать:}
    - типичные сценарии (sliding 60s/5s с дюжиной событий в окне) —
      выгоды нет, точность хуже, аллокации БОЛЬШЕ (state-объект p²
      дороже короткого списка);
    - нужна гарантированная точность (медианная зарплата, SLA p50);
    - bimodal/multimodal распределения — p² плохо ловит «провалы»
      между модами.

    {b Эмпирически (см. bench/bench_approx_median.ml)}: в реальном
    сценарии ex07 (окна с ~12 показаниями) approx_median {b медленнее}
    точной {!median}; на синтетическом окне с 10K событий — равны.
    Этот оператор есть скорее для пользователей с {e их} большими
    окнами (миллионы событий, например счёт telemetry метрик в Prometheus-
    подобном сценарии). *)

val to_list : ('a, 'a list) t

(** {2 Многоуровневые и top-K агрегаты} *)

val group_by :
  key:('a -> string) ->
  inner:('a, 'r) t ->
  ('a, (string * 'r) list) t
(** Двухуровневая агрегация внутри одного окна: значения группируются
    по подключу [key], к каждой группе применяется [inner]; результат —
    список [(подключ, inner_result)]. Естественная пара к
    {!Pipe.window_agg_keyed}: внешний ключ задаёт окно (например
    «шахтёр»), [group_by] делает второй уровень группировки внутри
    («биконы этого шахтёра»).

    {b Память}: O(числа подключей в окне) — для каждой подгруппы
    держится аккумулятор [inner]. *)

val top_k_by   : int -> by:('a -> float) -> ('a, 'a list) t
(** Top-K элементов по проекции [by], отсортированы по убыванию [by x].
    Аккумулятор — список длины ≤ K, вставка O(K), память O(K) на окно.
    [@raise Invalid_argument] при [k <= 0]. *)

val bottom_k_by : int -> by:('a -> float) -> ('a, 'a list) t
(** Bottom-K элементов по проекции [by], отсортированы по возрастанию.
    Симметрично {!top_k_by}; та же сложность.
    [@raise Invalid_argument] при [k <= 0]. *)

(** {2 Комбинирование} *)

(** [both a b] считает оба агрегата за один проход, результат — пара. *)
val both : ('a, 'r1) t -> ('a, 'r2) t -> ('a, 'r1 * 'r2) t

(** Applicative-let для слияния нескольких агрегатов:
    {[
      let stats = Agg.(
        let+ n   = count
        and+ avg = mean temp
        and+ hi  = max_by temp in
        (n, avg, hi))
    ]} *)
val ( let+ ) : ('a, 'r1) t -> ('r1 -> 'r2) -> ('a, 'r2) t
val ( and+ ) : ('a, 'r1) t -> ('a, 'r2) t -> ('a, 'r1 * 'r2) t

(** Преобразовать результат агрегата функцией. *)
val map : ('r1 -> 'r2) -> ('a, 'r1) t -> ('a, 'r2) t

(** Изменить тип входа: [contramap g agg] применяет [g] к каждому событию
    до агрегации (например проекция перед готовым агрегатом). *)
val contramap : ('b -> 'a) -> ('a, 'r) t -> ('b, 'r) t

(** {2 Применение} *)

(** Свернуть список через агрегатор (для тестов и разовых вычислений). *)
val run : ('a, 'r) t -> 'a list -> 'r

(** CPS-деструктор для интеграции с {!Pipe.window_agg}: разворачивает
    скрытый аккумулятор и передаёт [init]/[add]/[finish] в продолжение.
    Продолжение полиморфно по аккумулятору (rank-2), поэтому тип acc не
    «убегает». Обычно не нужен напрямую — используйте {!Pipe.window_agg}. *)
type ('a, 'r, 'b) parts_k =
  { k : 'acc. (unit -> 'acc) -> ('acc -> 'a -> 'acc) -> ('acc -> 'r) -> 'b }

val with_parts : ('a, 'r) t -> ('a, 'r, 'b) parts_k -> 'b

(** {2 Retract support (Phase 2)} *)

(** Поддерживает ли агрегат отзыв (remove) ранее добавленного элемента.

    Retractable:
    - {!count}, {!count_if}, {!sum}, {!mean}: O(1)
    - {!median}, {!to_list}: O(n) — удалить из списка
    - {!group_by}: если inner retractable
    - {!both}, {!map}, {!contramap}: если базовый retractable

    Не retractable (требуется полное знание окна):
    - {!min_by}, {!max_by}, {!arg_min}, {!arg_max}: после удаления
      текущего min/max нужно знать всех остальных
    - {!first}, {!last}: теряют идентификацию при удалении из середины
    - {!approx_median}: P² algorithm не поддерживает remove
    - {!top_k_by}, {!bottom_k_by}: храним только top K, не знаем
      "следующего" после retract из top *)
val is_retractable : ('a, 'r) t -> bool

(** Расширенный CPS-деструктор: передаёт также [remove] (опционально).
    Используется операторами Window для интеграции с {!Mf_event.Retract}. *)
type ('a, 'r, 'b) parts2_k = {
  k2 : 'acc.
    (unit -> 'acc) ->
    ('acc -> 'a -> 'acc) ->
    ('acc -> 'a -> 'acc) option ->
    ('acc -> 'r) -> 'b
}

val with_parts2 : ('a, 'r) t -> ('a, 'r, 'b) parts2_k -> 'b
