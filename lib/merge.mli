(** Слияние N watermarked-потоков (партиций) в один. Общий watermark =
    минимум по активным партициям; idle-стратегия (выбирается при
    создании) решает, учитывать ли молчащую партицию. *)

(** Как обходиться с молчащей партицией при расчёте минимума. *)
type idle_strategy =
  | Never
      (** всегда учитывать — строго, без потерь, но молчащая партиция
          застопорит общий watermark. *)
  | Wall_clock_timeout of int
      (** молчит столько реальных мс → idle, исключается из минимума;
          вернётся в расчёт когда снова даст событие. *)

(** [merge_partitioned ?now_ms ~idle streams] сливает потоки-партиции в
    один. Data/Retract пробрасываются по факту прихода; Watermark
    эмитится когда минимум по активным партициям продвинулся.
    Завершённая партиция исключается из минимума (оставшиеся доводят
    watermark — как в {!Mf_event.union}). [?now_ms] для тестируемости
    (по умолчанию системное время). *)
val merge_partitioned :
  ?now_ms:(unit -> int) ->
  idle:idle_strategy ->
  'a Mf_event.t Stream.t list ->
  'a Mf_event.t Stream.t
