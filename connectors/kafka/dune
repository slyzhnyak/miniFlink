; Kafka-коннектор — основная (тестируемая) часть.
; БЕЗ librdkafka: абстрактный клиент + in-memory фейк + адаптер.
; Логика offset-маппинга/seek/EO проверяется на фейке без брокера.
;
; Подкаталог rdkafka/ (прод-биндинг + интеграционный тест против живого
; брокера) исключён из обычной сборки — он требует системную librdkafka.
; Включается только в профиле 'rdkafka' (CI job kafka-eos).
(dirs :standard \ rdkafka)
(library
 (name kafka_connector)
 (libraries miniflink)
 (flags (:standard -w +a-4-26-27-32-33-37-39-41-42-44-45-70))
 (modules kafka_client kafka_fake kafka_source kafka_sink))

(test
 (name test_kafka_source)
 (libraries miniflink kafka_connector)
 (flags (:standard -w +a-4-26-27-32-33-37-39-41-42-44-45-70))
 (modules test_kafka_source))

(test
 (name test_kafka_sink)
